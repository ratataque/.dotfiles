{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "oh-my-openagent@latest",
        "opencode-antigravity-auth@1.6.0"
    ],
    "mcp": {
        "cloudflare-workers-bindings": {
            "enabled": false
        },
        "cloudflare-observability": {
            "enabled": false
        },
        "cloudflare": {
            "enabled": false
        },
        "filesystem": {
            "enabled": false
        },
        "supabase": {
            "enabled": false
        },
        "vercel": {
            "enabled": false
        },
        "google-space": {
            "enabled": false
        },
        "clickhouse": {
            "enabled": false
        },
        "firecrawl": {
            "enabled": false
        },
        "railway": {
            "enabled": false
        },
        "cloudflare-workers-builds": {
            "enabled": false
        },
        "cloudflare-docs": {
            "enabled": false
        }
    },
    "permission": {
        "edit": "ask"
    }
}
