"modules": [
	"break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────── Info ──────────────────┐"
        },
        {

            "type": "os",
            "key": " ",
            "keyColor": "31",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "33",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "35",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "36", 
        },
        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
    ]
